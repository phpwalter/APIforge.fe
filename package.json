{
  "name": "apiforge",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b",
    "typecheck:tests": "tsc --noEmit -p tsconfig.test.json",
    "build": "tsc -b && vite build",
    "lint": "oxlint --deny-warnings",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "npm run lint && npm run typecheck && npm run typecheck:tests && npm run test && npm run build"
  },
  "dependencies": {
    "@readme/openapi-schemas": "^4.0.0",
    "crypto-js": "^4.2.0",
    "highlight.js": "^11.11.1",
    "js-yaml": "^5.2.2",
    "lucide-react": "^0.378.0",
    "monaco-editor": "^0.50.0",
    "monaco-yaml": "^3.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^14.1.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/crypto-js": "^4.2.2",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.13.3",
    "@types/react": "^18.2.46",
    "@types/react-dom": "^18.2.18",
    "@vitejs/plugin-react": "^4.2.1",
    "jsdom": "^29.1.1",
    "oxlint": "^1.75.0",
    "typescript": "^5.4.5",
    "vite": "^5.2.11",
    "vitest": "^1.6.0"
  },
  "overrides": {
    "vscode-languageserver-types": "3.17.5"
  },
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  }
}
